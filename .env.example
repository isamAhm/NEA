# Copy this file to .env.local for local development. Nothing in this file is
# a real secret — it's a template. On GoDaddy Node.js Hosting, set these in the
# environment-variables panel of the hosting UI instead (never upload a .env).

# Public site URL — used for SEO metadata, sitemap.xml, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.neweraacademy.org

# --- Email delivery ---------------------------------------------------------
# Emails are sent through the hosting platform's built-in email gateway
# (src/server/email.ts) — no SMTP settings or API keys are needed.
#
# Inbox that receives contact, tour-request and career-application emails.
# REQUIRED in production: submissions fail (HTTP 502) while this is unset.
# In development, submissions are only logged to the server console.
CONTACT_FORM_RECIPIENT_EMAIL=
